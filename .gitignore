node_modules/
apikeys.json

# Generated by 'npm run harvest' — endpoints live in sources/, output does not belong in git.
# Anchored: an unanchored 'harvested/' also matches status/harvested/, where the
# probe history of those services lives and is meant to be kept.
/harvested/

# Built by 'npm run build-index' from layers/ + harvested/. Tracking it meant CI,
# which has no harvested/, could commit a truncated index over the real one.
layers/index.json
# Projected out of sources/ by the same build, for the previewer's live search.
layers/catalogues.json
.cache/
