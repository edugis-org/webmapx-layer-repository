      "type": "xyz",
      "endpoint": "https://api.tiles.openaip.net",
      "availability": "up",
      "layers": [
        {
          "id": "openaip-map",
          "title": "Aviation Chart",
          "abstract": "Airspaces, airports, navaids, and reporting points overlay. Transparent — add a basemap underneath.",
          "type": "raster",
          "status": "active",
          "requiresKey": true,
          "legendUrl": "https://edugis-org.github.io/webmapx-layer-repository/assets/legends/openaip-map.svg",
          "legendFrom": "https://api.tiles.openaip.net/api/styles/openaip-default-style.json",
          "legendNote": "openAIP publishes no legend image. This one is curated here, in assets/legends/, from the airspace paint of openAIP’s own published map style. The airport, navaid, obstacle and hotspot icons are not in it: that icon set is CC BY-NC-SA 4.0.",
          "webmapxConfig": {
            "source": {
              "type": "raster",
              "tiles": [
                "https://api.tiles.openaip.net/api/data/openaip/{z}/{x}/{y}.png?apiKey={key-openaip}"
              ],
              "tileSize": 256,
              "maxzoom": 14,
              "attribution": "&copy; <a href='https://www.openaip.net'>OpenAIP</a>"
            },
            "layer": {
              "id": "openaip-map",
              "type": "raster",
              "metadata": {
                "title": "OpenAIP Aviation Chart",
                "abstract": "Aviation chart overlay. Source: OpenAIP.",
                "legendRole": "overlay"
              }
            }
          },
          "availability": "up",
          "lastChecked": "2026-09-05"
        }
      ]
    },
